# ============================================================
# ZEVRO — Environment Variables Configuration
# ============================================================

# 1. MongoDB Database (Required)
# Local instance or MongoDB Atlas Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/zevro
# For MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/zevro?retryWrites=true&w=majority

# 2. NextAuth Authentication (Required)
NEXTAUTH_URL=http://localhost:3031
NEXTAUTH_SECRET=zevro-super-secret-auth-key-change-in-prod
NEXT_PUBLIC_APP_URL=http://localhost:3031

# 3. Admin & Superadmin Authentication (Required)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword
ADMIN_SESSION_SECRET=zevro-admin-session-secret-key-change-in-prod
SUPERADMIN_MASTER_KEY=superadmin

# 4. Razorpay Payment Gateway (Optional for Demo Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=secret_placeholder
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder

# 5. Shiprocket Logistics (Optional for Demo Mode)
SHIPROCKET_EMAIL=placeholder@email.com
SHIPROCKET_PASSWORD=placeholder_password

# 6. Cloudinary Media Asset Uploads (Optional)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
